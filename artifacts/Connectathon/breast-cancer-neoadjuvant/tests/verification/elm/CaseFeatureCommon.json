{"library":{"localId":"0","annotation":[{"type":"CqlToElmInfo","translatorVersion":"4.8.0","translatorOptions":"EnableAnnotations,EnableLocators,DisableListDemotion,DisableListPromotion","signatureLevel":"Overloads"},{"type":"Annotation","t":[],"s":{"r":"291","s":[{"value":["","library CaseFeatureCommon version '1.0.0'"]}]}}],"identifier":{"id":"CaseFeatureCommon","version":"1.0.0"},"schemaIdentifier":{"id":"urn:hl7-org:elm","version":"r1"},"usings":{"def":[{"localId":"1","localIdentifier":"System","uri":"urn:hl7-org:elm-types:r1","annotation":[]},{"localId":"206","locator":"27:1-27:26","localIdentifier":"FHIR","uri":"http://hl7.org/fhir","version":"4.0.1","annotation":[{"type":"Annotation","t":[],"s":{"r":"206","s":[{"value":["/*\n * CaseFeatureCommon (CFH) — shared truth-set helpers for the case-feature\n * model. Like CRLCommon, this is a FIXED shared helper library that the\n * emitted policy libraries `include` (one shared file, not a per-policy copy).\n *\n * The case-feature model represents each leaf `code is` concept as a boolean\n * case feature: an Observation with a boolean value. `asTruths` lifts the\n * retrieved Observation list into a truth-set — a `List<System.Boolean>` that\n * holds a single `true` when any retrieved Observation asserts the feature,\n * and is empty otherwise. Truth-sets compose with CQL's list set operators:\n *   - `sem-or`  → `union`\n *   - `sem-and` → `intersect`\n *   - `sem-not` → `except` — from a positive base (`A sem-and sem-not B` → `A\n *     except B`); a NO-BASE `sem-not` (standalone, or a `sem-or` term) negates\n *     from the unit universe: `sem-not X` → `({ true } except (X))` (#232). On\n *     singleton/empty truth-sets `except` is exactly closed-world `and not`, so\n *     `{ true } except X` is `{ true }` iff X is not established.\n * `satisfied` collapses a truth-set back to a boolean for the Interface layer.\n *\n * Both functions are FLUENT, so call sites invoke them method-style\n * (`LocalSource.\"X\".asTruths()`, `Inferred.\"Y\".satisfied()`) and do not need\n * the `CFH.` qualifier — only the `include` is required.\n */\n\n","using "]},{"s":[{"value":["FHIR"]}]},{"value":[" version '4.0.1'"]}]}}]}]},"includes":{"def":[{"localId":"208","locator":"29:1-29:70","localIdentifier":"FHIRHelpers","path":"http://hl7.org/fhir/uv/cql/FHIRHelpers","version":"4.0.1","annotation":[{"type":"Annotation","t":[],"s":{"r":"208","s":[{"value":["","include "]},{"s":[{"value":["hl7",".","fhir",".","uv",".","cql",".","FHIRHelpers"]}]},{"value":[" version ","'4.0.1'"," called ","FHIRHelpers"]}]}}]}]},"contexts":{"def":[{"localId":"213","locator":"31:1-31:15","name":"Patient","annotation":[]}]},"statements":{"def":[{"localId":"211","locator":"31:1-31:15","name":"Patient","context":"Patient","annotation":[],"expression":{"type":"SingletonFrom","localId":"212","annotation":[],"signature":[],"operand":{"type":"Retrieve","localId":"210","locator":"31:1-31:15","dataType":"{http://hl7.org/fhir}Patient","templateId":"http://hl7.org/fhir/StructureDefinition/Patient","annotation":[],"include":[],"codeFilter":[],"dateFilter":[],"otherFilter":[]}}},{"type":"FunctionDef","localId":"214","locator":"33:1-34:93","name":"asTruths","context":"Patient","accessLevel":"Public","fluent":true,"annotation":[{"type":"Annotation","t":[],"s":{"r":"214","s":[{"value":["","define fluent function asTruths(obs List<FHIR.Observation>):\n  "]},{"r":"220","s":[{"r":"220","s":[{"value":["if "]},{"r":"221","s":[{"value":["exists "]},{"r":"230","s":[{"value":["("]},{"r":"230","s":[{"s":[{"r":"222","s":[{"r":"223","s":[{"s":[{"value":["obs"]}]}]},{"value":[" ","O"]}]}]},{"value":[" "]},{"r":"228","s":[{"value":["where "]},{"r":"228","s":[{"r":"227","s":[{"r":"226","s":[{"r":"225","s":[{"value":["O"]}]},{"value":["."]},{"r":"226","s":[{"value":["value"]}]}]},{"value":["."]},{"r":"227","s":[{"value":["value"]}]}]},{"value":[" is true"]}]}]}]},{"value":[")"]}]}]},{"value":[" then "]},{"r":"231","s":[{"r":"232","value":["{ ","t